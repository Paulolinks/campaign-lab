# Produção (VPS): copie para .env e troque os valores. Em desenvolvimento local nada disto é obrigatório:
# o app usa os padrões de src/lib/env.ts (banco do compose.dev.yaml na porta 5434).
DATABASE_URL=postgresql://campaignlab:SENHA@postgres:5432/campaignlab
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública do app, ex.: https://ads.seudominio.com
BETTER_AUTH_URL=
# Pasta dos arquivos enquanto o Google Drive não estiver conectado.
MEDIA_DIR=/data/media
# Tamanho máximo de upload em MB.
MAX_UPLOAD_MB=500
